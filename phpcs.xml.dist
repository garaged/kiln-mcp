<?xml version="1.0"?>
<ruleset name="Kiln MCP">
  <description>WordPress coding standards for production code.</description>
  <file>kiln-mcp.php</file>
  <file>src</file>
  <exclude-pattern>vendor/*</exclude-pattern>
  <arg name="basepath" value="."/>
  <arg name="colors"/>
  <rule ref="WordPress"/>
  <rule ref="WordPress-Extra"/>
  <rule ref="WordPress-Docs"/>
</ruleset>
