ARG COMPOSER_IMAGE=composer:2.8
ARG WPCLI_IMAGE=wordpress:cli-2.12.0-php8.2
ARG WORDPRESS_IMAGE=wordpress:7.1.3-php8.2-apache

FROM ${COMPOSER_IMAGE} AS plugin-vendor
WORKDIR /plugin
COPY composer.json ./
COPY src ./src
RUN composer install --no-dev --no-interaction --prefer-dist --no-progress --optimize-autoloader

FROM ${WPCLI_IMAGE} AS wp-cli

FROM ${WORDPRESS_IMAGE}
COPY --from=wp-cli /usr/local/bin/wp /usr/local/bin/wp
COPY --from=plugin-vendor /plugin/vendor /opt/kiln/plugin/vendor
COPY kiln-mcp.php /opt/kiln/plugin/kiln-mcp.php
COPY src /opt/kiln/plugin/src
COPY testing/scripts /opt/kiln/scripts
COPY testing/fixtures /opt/kiln/fixtures
RUN chmod 0555 /opt/kiln/scripts/*.sh
